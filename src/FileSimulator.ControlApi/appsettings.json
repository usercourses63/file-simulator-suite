{
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "Kubernetes": {
    "InCluster": true,
    "Namespace": "file-simulator"
  },
  "Kafka": {
    "BootstrapServers": "file-sim-file-simulator-kafka:9092"
  },
  "ConnectionInfo": {
    "Hostname": "file-simulator.local"
  },
  "MountHealth": {
    "MountPath": "/mnt/simulator-data",
    "CheckIntervalSeconds": 10,
    "StaleThresholdFailures": 3,
    "ProbeTimeoutMs": 2000,
    "AutoRestartOnRecovery": true
  }
}
